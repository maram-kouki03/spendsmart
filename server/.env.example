# SpendSmart API settings. Locally: copy this file to server/.env. On Render: set the same variables
# under the service → Environment (see "Deployment" in the README). Never commit real values.

# Postgres connection string. Supabase: Project → Connect → "Transaction pooler" (port 6543), e.g.
# postgresql://postgres.YOURPROJECTREF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# The Session pooler (port 5432) works too. SSL is turned on automatically (except for localhost).
# The code keeps no session state (no named prepared statements, SET LOCAL only, transaction-level
# advisory locks), so the Transaction pooler is safe.
# Migrations are run by hand, never on deploy: npm run db:migrate -w server
DATABASE_URL=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port to listen on. Render sets PORT itself, so don't set it there.
PORT=4000

# "production" on Render: secure cookies, trust proxy, strict CORS. Leave empty locally.
NODE_ENV=

# Comma-separated origins allowed to call the API with cookies (the React app).
# Production: the Vercel URL(s), e.g. https://spendsmart.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Public URL of the React app, used in password-reset links. Production: the Vercel URL.
APP_URL=http://localhost:5173

# Optional: how many proxy hops to trust for the client IP (rate limits). Default in production: 1.
# LOG_CLIENT_IP=1 logs the IP the server sees for each /api request (to check the setting, then remove).
TRUST_PROXY=
LOG_CLIENT_IP=

# Optional: Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web").
# Add http://localhost:5173 (and the Vercel URL in production) to its "Authorized JavaScript origins".
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# ---- Email (sign-up confirmation codes and password-reset links) ----
# Leave BREVO_API_KEY and SMTP_HOST empty to print emails in this server's console instead, e.g.
#   [DEV] Verification code for you@example.com: 123456
# (In production, email must be configured: sign-up fails without it.)

# Option 1, recommended for Render: Brevo's HTTP API (HTTPS, so blocked SMTP ports don't matter).
# Brevo → SMTP & API → API keys → "Generate a new API key". When set, the SMTP_HOST/PORT/USER/PASS
# settings below are ignored; SMTP_FROM is still the sender and must be verified in Brevo → Senders.
BREVO_API_KEY=

# Option 2: SMTP. Port 587 uses STARTTLS, 465 uses TLS. For Gmail use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender for both options. For Gmail, use the same address as SMTP_USER (or a "Send mail as" alias).
SMTP_FROM="SpendSmart <you@gmail.com>"

# Test the email settings with: npm run email:test -w server -- you@example.com
