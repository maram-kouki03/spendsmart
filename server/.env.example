# Postgres connection string. Supabase: Project → Connect → "Transaction pooler" (port 6543) or
# "Session pooler" (port 5432) — both work, e.g.
# postgresql://postgres.YOURPROJECTREF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# SSL is turned on automatically (except for localhost). The code keeps no session state (no named
# prepared statements, SET LOCAL only, transaction-level advisory locks), so the Transaction pooler is safe.
DATABASE_URL=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# Comma-separated origins allowed to call the API with cookies (the React app)
CLIENT_ORIGIN=http://localhost:5173

# Public URL of the React app, used in password-reset links
APP_URL=http://localhost:5173

# Optional: Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web").
# Add http://localhost:5173 to its "Authorized JavaScript origins". Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Optional: SMTP for emails (sign-up confirmation codes and password-reset links). When SMTP_HOST
# is empty they are printed in this server's console instead, e.g.
#   [DEV] Verification code for you@example.com: 123456
# Port 587 uses STARTTLS, 465 uses TLS. For Gmail use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# For Gmail, use the same address as SMTP_USER (or a "Send mail as" alias set up in Gmail).
SMTP_FROM="SpendSmart <you@gmail.com>"
