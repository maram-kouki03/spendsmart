# Supabase project → Settings → API (the public anon key, never the service-role key)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave empty in development (Vite proxies /api to the Node server).
# In production, set it to the API's origin, e.g. https://api.spendsmart.app
VITE_API_URL=
