# Leave VITE_API_URL empty, both locally and on Vercel: the app calls relative /api/... URLs.
#   - Locally, Vite proxies /api to the API on http://localhost:4000 (client/vite.config.js).
#   - On Vercel, client/vercel.json rewrites /api/* to the Render API, so the session cookie stays
#     first-party (same origin as the app).
# Set it only if you serve the API on another origin without a proxy (then CORS + cookies cross sites).
VITE_API_URL=
