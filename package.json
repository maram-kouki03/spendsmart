{
  "name": "spendsmart",
  "private": true,
  "version": "1.0.0",
  "description": "SpendSmart — know where every coin goes. React + Node + PostgreSQL (hosted on Supabase).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint client/src server/src",
    "lint:fix": "eslint client/src server/src --fix",
    "format": "prettier --write client/src server/src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
